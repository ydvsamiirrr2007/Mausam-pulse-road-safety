# Change before any shared deployment.
MAUSAM_API_KEY=replace-with-a-long-random-secret

# The container listens on 8080; this controls the host binding.
MAUSAM_PORT=8080

# Synthetic rain/fog vehicles and alerts.
MAUSAM_DEMO_MODE=true
MAUSAM_DEMO_INTERVAL=2

# Browser origins allowed to call the API. Comma-separated values are accepted.
MAUSAM_CORS_ORIGIN=http://localhost:8080

# Persisted SQLite path inside the container.
MAUSAM_DATABASE=/data/mausam-pulse.db
